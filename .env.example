# Database (SQLite for local dev)
DATABASE_URL="file:./dev.db"

# Secret used to sign auth session cookies. BẮT BUỘC ở production (>= 32 ký tự).
# Tạo chuỗi ngẫu nhiên, ví dụ: openssl rand -base64 32
AUTH_SECRET="thay-bang-chuoi-ngau-nhien-it-nhat-32-ky-tu"

# (Tuỳ chọn) Redis cho realtime đa-instance. Bỏ trống = chạy realtime in-memory
# (chỉ đúng khi 1 instance). Đặt URL để bật Redis pub/sub khi scale nhiều instance.
# REDIS_URL="redis://localhost:6379"
