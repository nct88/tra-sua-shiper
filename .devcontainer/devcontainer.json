{
  "name": "Boba Ship",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:22",
  "postCreateCommand": "npm install && cp -n .env.example .env && npm run db:push && npm run db:seed",
  "forwardPorts": [3000],
  "portsAttributes": {
    "3000": {
      "label": "Boba Ship",
      "onAutoForward": "openBrowser"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": ["Prisma.prisma"]
    }
  }
}
